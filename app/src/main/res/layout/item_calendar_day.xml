<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="2dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/calendar_day_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tv_day_number"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="1"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Today dot indicator -->
        <View
            android:id="@+id/view_today_dot"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:background="@drawable/calendar_day_today_bg"
            android:visibility="gone"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Count badge (top-right corner) -->
    <TextView
        android:id="@+id/tv_day_badge"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="end|top"
        android:text="3"
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:background="@drawable/priority_dot_bg"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp" />

</FrameLayout>
