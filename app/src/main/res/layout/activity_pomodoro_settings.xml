<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/surface_light">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/yellow_primary"
        android:elevation="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🍅 番茄钟设置"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Work duration -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="16dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🍅 专注时长（分钟）"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edit_work_duration"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:inputType="number"
                        android:text="25"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/chip_default_bg" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Short break -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="16dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="☕ 短休息（分钟）"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edit_short_break"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:inputType="number"
                        android:text="5"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/chip_default_bg" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Long break -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="16dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="😴 长休息（分钟）"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edit_long_break"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:inputType="number"
                        android:text="15"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/chip_default_bg" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cycles -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="24dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔁 长休息前循环次数"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edit_cycles"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:inputType="number"
                        android:text="4"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/chip_default_bg" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="💾 保存设置"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/yellow_dark"
                android:textColor="@color/text_primary"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
